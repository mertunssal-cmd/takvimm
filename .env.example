# Bu dosyayı ".env" adıyla kopyalayın ya da "npm run setup" ile otomatik oluşturun.
# .env dosyası GİZLİDİR, git'e eklenmez.

# Giriş bilgileri ("npm run setup" bunları sizin için doldurur)
APP_USERNAME=mert
# Şifrenin bcrypt özeti. Şifrenin kendisini buraya YAZMAYIN.
APP_PASSWORD_HASH='$2b$12$...'

# İsteğe bağlı
# PORT=3000
# DB_PATH=./data/takvim.db
# Önünde ters vekil (Caddy, Cloudflare, Render...) varsa 1 (varsayılan).
# Sunucuyu vekil olmadan doğrudan internete açıyorsanız 0 yapın (yanlış giriş sınırı atlatılamasın):
# TRUST_PROXY=1
